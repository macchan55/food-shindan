# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY is server-only — never expose it to the browser or commit it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by Supabase Auth in the browser (sign up / log in for the resume builder). The
# publishable key is meant to be public, like a Stripe publishable key — safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Used for AI-generated resume text (self-PR / work summary) — same key already used for
# character art generation.
OPENAI_API_KEY=your-openai-api-key
